            <Text style={[styles.statLabel, { color: theme.subtext }]}>Heart</Text>
          </View>
          <View style={[styles.statCard, { backgroundColor: theme.card, width: width * 0.28 }]}>
            <MaterialCommunityIcons name="bed" size={28} color="#6FCF97" />
